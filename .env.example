# Prisma V5.0 — Environment Variables Template
# Copy to .env.local and fill in real values. Never commit .env.local.
# Reference: docs/09_Deployment_Pipeline.md §2.1

# Supabase project URL — safe for client-side (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key — safe for client-side (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Backend/Server Actions only. MUST NEVER be
# prefixed with NEXT_PUBLIC_ or reach client-side code (05_Security_Governance_Policy.md §1.3).
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider keys for the Policy Agent / TRM loop — Backend only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
